[Unit]
Description=Remy Ellis Notes API
After=network.target

[Service]
Type=simple
User=remy
Group=remy
WorkingDirectory=/var/www/remyellis.au
EnvironmentFile=/etc/remy-notes.env
ExecStart=/usr/bin/node /var/www/remyellis.au/server/notes-server.js
Restart=on-failure
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/remy-notes

[Install]
WantedBy=multi-user.target
